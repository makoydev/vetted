{
  "name": "vetted",
  "description": "Governed, advisory AI code review for GitHub Actions",
  "version": "0.0.0",
  "author": "Michael Mendoza",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/makoydev/vetted",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makoydev/vetted.git"
  },
  "bugs": {
    "url": "https://github.com/makoydev/vetted/issues"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run canary && npm run package",
    "vendor:gitleaks": "node scripts/vendor-gitleaks.ts",
    "measure:entropy": "node scripts/measure-entropy.ts",
    "parity:gitleaks": "node scripts/parity-gitleaks.ts",
    "canary": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest --coverage=false --testPathIgnorePatterns /dist/ /node_modules/ --testPathPatterns __tests__/canary"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "re2js": "2.8.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.0",
    "@types/picomatch": "4.0.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "rollup": "4.63.5",
    "smol-toml": "1.9.0",
    "ts-jest": "29.4.14",
    "ts-jest-resolver": "2.0.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
